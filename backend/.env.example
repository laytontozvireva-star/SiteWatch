# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase Credentials (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vercel integration (required only when enabling Vercel connection)
VERCEL_OAUTH_CLIENT_ID=your-vercel-oauth-client-id
VERCEL_OAUTH_CLIENT_SECRET=your-vercel-oauth-client-secret
VERCEL_OAUTH_REDIRECT_URI=https://your-api.example.com/api/integrations/vercel/callback
VERCEL_WEBHOOK_SECRET=your-vercel-webhook-secret
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VERCEL_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-random-key
